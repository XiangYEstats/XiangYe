{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Website: Build",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["build.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Website: Preview",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "http.server", "8000", "--directory", "docs"],
      "options": {"cwd": "${workspaceFolder}"},
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Website: Validate",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["validate.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
