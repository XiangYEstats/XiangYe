{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xiangye-like-counter",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-02",
  "vars": {
    "ALLOWED_ORIGIN": "https://xiangyestats.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xiangye-like-counter",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "ratelimits": [
    {
      "name": "LIKE_RATE_LIMITER",
      "namespace_id": "26090201",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
